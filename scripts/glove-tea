#!/bin/sh
# Launch the Bubble Tea prototype from any working directory.
set -eu
repo=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo"
if [ -x "$repo/build/glove-tea" ]; then
  exec "$repo/build/glove-tea" --root "$repo" "$@"
fi
go_cmd=${GLOVE_GO:-go}
if ! command -v "$go_cmd" >/dev/null 2>&1; then
  echo 'Go 1.26+ is required to build the prototype. See tui/README.md.' >&2
  exit 1
fi
cd "$repo/tui"
exec "$go_cmd" run . --root "$repo" "$@"
